# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://shajkhcsshkxxovdhmoe.supabase.co
SUPABASE_SERVICE_KEY=TU_SERVICE_ROLE_KEY_AQUI
NEXT_PUBLIC_SUPABASE_URL=https://shajkhcsshkxxovdhmoe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# ─── JWT ───────────────────────────────────────────────────
# Clave JWT de Supabase (Settings > API > JWT Secret)
# Esta clave es diferente a la Anon Key
SUPABASE_JWT_SECRET=TU_SUPABASE_JWT_SECRET_AQUI

# ─── JWT Custom (legacy) ────────────────────────────────────
# Genera un string aleatorio largo y ponlo aquí
# En terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio

# ─── Servidor ───────────────────────────────────────────────
PORT=3000

# ─── CORS ───────────────────────────────────────────────────
# En desarrollo puedes dejar * — en producción pon tu dominio
ALLOWED_ORIGIN=*
